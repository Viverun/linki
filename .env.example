# Copy this file to .env.local and fill in your values

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Password to log in to the Linki UI
AUTH_PASSWORD=

# Internal secret for server-to-server API calls (e.g. the MCP server calling Linki's own
# /api/* routes over loopback). Generate with: openssl rand -base64 32
# Never sent to a browser or exposed externally — only Node processes on this host see it.
INTERNAL_API_SECRET=

# SQLite database path (optional — defaults to ./linki.db in cwd)
# When running via Docker, this is set automatically to /data/linki.db
LINKI_DB_PATH=

# Set to "false" to show the browser window during automation (useful for debugging)
HEADLESS=true

# Optional. Where degraded/dead runner alerts are POSTed (Slack, Discord, ntfy,
# a webhook relay — anything that accepts a JSON body).
#
# Fires on TRANSITION only — entering degraded, entering dead, and recovering —
# never once per failing tick. Leave it empty and nothing is sent; the in-app
# banner still appears either way.
#
# The body is a FIXED five-key payload and deliberately carries no identifying
# detail — no target names, no message text, no account data, no error messages,
# only an allowlisted error class:
#   {"service":"linki","state":"degraded","consecutive_tick_failures":5,
#    "error_class":"SqliteError","timestamp":"..."}
# Treat the URL itself as a secret: anyone holding it can post into your channel.
ALERT_WEBHOOK_URL=
